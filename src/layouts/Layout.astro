---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { otherLocale, type Locale } from "../i18n/strings";

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
}

const { locale, path, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteName = locale === "ja" ? site.titleJa : site.titleEn;
const fullTitle = path === "" ? siteName : `${title} | ${site.shortName}`;
const canonical = new URL(`${base}/${locale}${path}`, Astro.site);
const alt = new URL(`${base}/${otherLocale(locale)}${path}`, Astro.site);
/** Japanese is the default locale, so it answers for unmatched languages. */
const defaultHref = new URL(`${base}/ja${path}`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  name: siteName,
  alternateName: site.shortName,
  url: canonical.href,
  email: site.email,
  parentOrganization: { "@type": "CollegeOrUniversity", name: "Keio University" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "3-14-1 Hiyoshi, Kohoku-ku",
    addressLocality: "Yokohama",
    addressRegion: "Kanagawa",
    postalCode: "223-8522",
    addressCountry: "JP",
  },
  employee: { "@type": "Person", name: site.pi, jobTitle: "Associate Professor" },
};
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={locale} href={canonical.href} />
    <link rel="alternate" hreflang={otherLocale(locale)} href={alt.href} />
    <!-- Tells search engines which version to serve a visitor whose locale matches neither. -->
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:image" content={new URL(`${base}/og-cover.webp`, Astro.site).href} />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="843" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${base}/og-cover.webp`, Astro.site).href} />
    <link rel="icon" href={`${base}/csg.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/csg.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Scroll-reveal is applied by script; without JS the content must still show. -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    {
      /* Google Analytics, production only — dev and preview traffic would otherwise
         pollute the numbers. `is:inline` keeps gtag out of Astro's bundle, which it
         requires to register on window. */
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`} />
          <script
            is:inline
            set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${site.analyticsId}');
`}
          />
        </>
      )
    }
  </head>
  <body class="min-h-screen antialiased">
    <a class="skip-link" href="#main-content">{locale === "ja" ? "本文へ移動" : "Skip to content"}</a>
    <Header locale={locale} path={path} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
