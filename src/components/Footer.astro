---
import { site } from "../data/site";
import type { Locale } from "../i18n/strings";
interface Props { locale: Locale }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><a class="footer-wordmark" href={`${base}/${locale}`}>CSG<span>↗</span></a><p>Computing and Sensing Group</p><p class="muted">{locale === "ja" ? "慶應義塾大学 吉岡研究室" : "Yoshioka Lab · Keio University"}</p></div>
    <div><p class="eyebrow">VISIT US</p><address>{site.address[locale]}<br /><span class="muted">Students: {site.rooms.students}<br />PI: {site.rooms.pi}</span></address><a class="text-link" href={site.mapUrl} target="_blank" rel="noopener">Yagami Campus <span aria-hidden="true">↗</span></a></div>
    <div><p class="eyebrow">LET’S CONNECT</p><a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a><div class="social-links"><a href={site.socials.github} target="_blank" rel="noopener">GitHub ↗</a><a href={site.socials.kaggle} target="_blank" rel="noopener">Kaggle ↗</a></div></div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Computing and Sensing Group</span><span>KEIO UNIVERSITY · YOKOHAMA, JAPAN</span><a href="#main-content">Back to top ↑</a></div>
</footer>
