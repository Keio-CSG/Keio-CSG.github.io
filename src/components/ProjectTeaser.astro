---
import { Image } from "astro:assets";
import GeneratedTeaser from "./GeneratedTeaser.astro";
import type { ProjectCategory } from "../data/projectCategories";

/**
 * The card artwork for a project.
 *
 * Preferred: a hand-commissioned illustration at
 * `src/assets/projects/<slug>.webp`, drawn to show what the project actually
 * does — the attack, the sensor, the circuit. Wordless, because the card
 * prints venue, year and title right beneath it, and because the same image
 * serves both the Japanese and the English page.
 *
 * Fallback: `GeneratedTeaser`, which draws an abstract composition from the
 * slug. A project with no illustration yet still gets a card that looks
 * deliberate, so adding a project never blocks on artwork.
 */
interface Props {
  category: ProjectCategory;
  /** The project slug: also the illustration's filename. */
  seed: string;
  class?: string;
}

const { category, seed, class: className = "" } = Astro.props;

const illustrations = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/projects/*.webp",
  { eager: true },
);
const art = illustrations[`../assets/projects/${seed}.webp`]?.default;
---

{
  art ? (
    <Image
      src={art}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 400px, 100vw"
      class:list={["bg-white object-cover", className]}
    />
  ) : (
    <GeneratedTeaser category={category} seed={seed} class={className} />
  )
}
