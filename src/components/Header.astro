---
import { t, otherLocale, type Locale } from "../i18n/strings";
import { site } from "../data/site";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const s = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (p: string) => `${base}/${locale}${p}`;
const other = otherLocale(locale);
const altHref = `${base}/${other}${path}`;

const links = [
  { label: s.nav.research, to: "/research" },
  { label: s.nav.projects, to: "/projects" },
  { label: s.nav.papers, to: "/papers" },
  { label: s.nav.members, to: "/members" },
  { label: s.nav.recruit, to: "/recruit" },
];
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href={href("")} class="group flex items-center gap-2.5 shrink-0">
      <span class="relative grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-accent-500 to-signal-500">
        <span class="text-[13px] font-bold tracking-tight text-ink-950">CS</span>
      </span>
      <span class="hidden text-sm font-semibold tracking-tight sm:block">
        Keio <span class="text-accent-400">CSG</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={href(l.to)}
          class:list={[
            "rounded-md px-3 py-2 text-sm text-slate-300 transition-colors hover:bg-white/5 hover:text-white",
            path.startsWith(l.to) && "bg-white/5 text-white",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={altHref}
        class="rounded-md border border-white/10 px-2.5 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-accent-400/40 hover:text-accent-400"
      >
        {s.common.langSwitch}
      </a>
      <a
        href={`mailto:${site.email}`}
        class="hidden rounded-md bg-accent-500 px-3 py-1.5 text-xs font-semibold text-ink-950 transition-colors hover:bg-accent-400 sm:block"
      >
        Contact
      </a>
      <button
        id="nav-toggle"
        aria-label="Menu"
        class="grid h-9 w-9 place-items-center rounded-md border border-white/10 text-slate-300 md:hidden"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M2 4h12M2 8h12M2 12h12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-white/5 bg-ink-900 px-5 py-3 md:hidden">
    {links.map((l) => (
      <a href={href(l.to)} class="block rounded-md px-3 py-2.5 text-sm text-slate-300 hover:bg-white/5 hover:text-white">
        {l.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
