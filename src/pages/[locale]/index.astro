---
import Layout from "../../layouts/Layout.astro";
import edgeIllustration from "../../../figs/edge.webp";
import mascot from "../../../figs/health.webp";
import mainVisual from "../../../figs/main.webp";
import { researchThemes } from "../../data/research";
import { news } from "../../data/news";
import { projects } from "../../data/projects";
import { locales, type Locale } from "../../i18n/strings";
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const ja = locale === "ja";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}/${locale}${path}`;
const description = ja ? "慶應義塾大学 吉岡研究室。回路、AI、LiDARセンシング、セキュリティを横断し、未来のコンピューティングとセンシングをつくる。" : "Computing and Sensing Group at Keio University. Exploring circuits, AI, LiDAR sensing and security to build what comes next.";
const areaLabels = ["Beyond digital limits.", "Trust in every signal.", "A new dimension of sensing."];
const areaSummaries = ja ? ["アナログ回路とAIの融合で、計算の限界を超える。超低消費電力な次世代コンピューティングへ。", "センサーの脆弱性を解き明かし、自動運転の信頼性を高める。現実世界で機能するセキュリティへ。", "光で世界を捉え、見えなかった情報を引き出す。モビリティからスポーツ、医療まで。"] : ["Bringing analog circuits and AI together to push the limits of energy-efficient computing.", "Uncovering sensor vulnerabilities and building trustworthy autonomous systems for the real world.", "Capturing the world through light. From mobility to sports and healthcare, sensing new possibilities."];
---
<Layout locale={locale} path="" title="Home" description={description}>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-topline"><span class="eyebrow"><span class="status-dot"></span> COMPUTING AND SENSING GROUP</span><span class="mono hero-location">KEIO / YOKOHAMA, JP</span></div>
      <div class="hero-copy">
        <p class="hero-affiliation">{ja ? "慶應義塾大学 理工学部 吉岡研究室" : "Yoshioka Laboratory · Keio University"}</p>
        <h1>Sense beyond.<br /><span>Compute ahead.</span></h1>
        <h2>{ja ? "まだ見えない未来を、つくる。" : "Make the unseen possible."}</h2>
        <p class="hero-description">{ja ? <>回路からAIへ、センシングから社会へ。<br />ハードとソフトの境界を越え、<br class="mobile-break" />次の「あたりまえ」を生み出す。</> : <>From circuits to AI. From sensing to society.<br />We cross the boundaries of hardware and software<br />to build what comes next.</>}</p>
        <div class="hero-buttons"><a class="button button-primary" href={href("/research")}>{ja ? "研究を知る" : "Explore research"}<span aria-hidden="true">↗</span></a><a class="text-link" href={href("/recruit")}>{ja ? "研究室に参加する" : "Join our lab"}<span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-art"><img src={mainVisual.src} width={mainVisual.width} height={mainVisual.height} alt={ja ? "回路でつながる自動運転、ロボット、医療を描いた研究室のイラスト" : "Lab illustration connecting autonomous vehicles, robots, and healthcare through circuits"} fetchpriority="high" /><div class="art-caption"><span>COMPUTING AND SENSING GROUP</span><span>COMPUTING × SENSING</span></div></div>
      <div class="hero-bottom"><span>HARDWARE. SOFTWARE. REAL WORLD.</span><a href="#research">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
    </div>
  </section>
  <section class="venue-strip"><div class="shell venue-inner"><span class="eyebrow">OUR RESEARCH REACHES</span><div>{["ISSCC", "JSSC", "CVPR", "ICCV", "NDSS", "ICRA", "IROS"].map(venue => <span>{venue}</span>)}</div></div></section>
  <section class="section shell" id="research">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-number">01 /</span> OUR RESEARCH</p><h2>{ja ? <>境界を越えて、<br />可能性をひらく。</> : <>Across disciplines.<br />Beyond possibilities.</>}</h2></div><div class="section-intro"><p>{ja ? "回路からアルゴリズム、そして実社会へ。3つの研究領域を軸に、コンピューティングとセンシングの未来を探求しています。" : "From circuits and algorithms to real-world impact. Three connected fields, one ambition: to shape the future of computing and sensing."}</p><a class="text-link" href={href("/research")}>{ja ? "研究内容を詳しく" : "Discover our research"}<span aria-hidden="true">↗</span></a></div></div>
    <div class="research-grid">{researchThemes.map((theme, i) => <a class="research-card" href={`${href("/research")}#${theme.slug}`}><div class="research-card-top"><span class="mono">0{i+1}</span><span class="circle-arrow" aria-hidden="true">↗</span></div><div class="research-art"><img src={(i === 0 ? edgeIllustration : i === 1 ? mainVisual : mascot).src} width={(i === 0 ? edgeIllustration : i === 1 ? mainVisual : mascot).width} height={(i === 0 ? edgeIllustration : i === 1 ? mainVisual : mascot).height} alt="" loading="lazy" class:list={{ "research-scene": i === 1 }} /></div><p class="eyebrow">{areaLabels[i]}</p><h3>{theme.title.en}</h3>{ja && <p class="research-ja">{theme.title.ja}</p>}<p class="research-summary">{areaSummaries[i]}</p></a>)}</div>
  </section>
  <section class="news-section"><div class="shell news-layout"><div><p class="eyebrow"><span class="section-number">02 /</span> LATEST UPDATES</p><h2>What’s new.</h2><p class="muted">{ja ? "研究室の、いま。" : "Life and discoveries at CSG."}</p><a class="text-link" href={href("/news")}>{ja ? "すべてのニュース" : "All news"}<span aria-hidden="true">↗</span></a></div><ul class="news-list">{news.slice(0, 4).map(item => <li><div class="news-meta"><time datetime={item.date}>{item.date.replace("-", ".")}</time><span class={`tag tag-${item.tag}`}>{item.tag ?? "lab"}</span></div><p>{item[locale]}</p></li>)}</ul></div></section>
  <section class="section shell"><div class="section-heading"><div><p class="eyebrow"><span class="section-number">03 /</span> SELECTED PROJECTS</p><h2>Ideas into impact.</h2><p class="muted">{ja ? "問いを、かたちに。" : "Research that moves the world forward."}</p></div><a class="text-link" href={href("/projects")}>{ja ? "すべてのプロジェクト" : "All projects"}<span aria-hidden="true">↗</span></a></div><div class="project-list">{projects.slice(0, 3).map((project, i) => <a class="project-row" href={`${href("/projects")}#${project.slug}`}><span class="mono project-index">0{i+1}</span><div><span class="eyebrow">{project.venue} / {project.year}</span><h3>{project.title}</h3><p>{project.subtitle}</p></div><span class="circle-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <section class="join-section"><div class="shell join-inner"><div><p class="eyebrow">THE NEXT DISCOVERY STARTS WITH YOU</p><h2>Stay curious.<br />Build what’s next<span>.</span></h2><p>{ja ? "慶應から、世界へ。次の挑戦を、一緒に。" : "From Keio to the world. Let’s take the next step together."}</p></div><img class="join-mascot" src={mascot.src} width={mascot.width} height={mascot.height} alt={ja ? "研究室のマスコット" : "Our lab mascot"} loading="lazy" /><a class="join-circle" href={href("/recruit")}><span aria-hidden="true">↗</span>JOIN OUR LAB</a></div></section>
</Layout>
